{
  "manifest_version": 3,
  "name": "Rabin Assistant - Manual Fill",
  "version": "0.1.0",
  "description": "Fill Rabin order form fields from a scheduled order. Never submits orders.",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "Rabin Assistant"},
  "browser_specific_settings": {"gecko": {"id": "rabin-assistant-manual-fill@example.com", "strict_min_version": "128.0"}}
}